# Server
PORT=3000

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blogdb
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Seed admin (used by: npm run seed:admin)
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=One
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123
