        {
          "name": "Customer Send Money",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const limitHit = res.message && res.message.includes(\"limit exceeded\");",
                  "",
                  "pm.test(limitHit ? \"Daily Amount Exceed\" : \"Send money successful\", function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res.details).to.be.an(\"object\");",
                  "        pm.expect(res.details.remainingAmount).to.be.a(\"number\");",
                  "    } else {",
                  "        pm.expect(res.message).to.include(\"Send money successful\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(limitHit",
                  "    ? `Daily Amount Exceed - remaining ${res.details.remainingAmount} Tk`",
                  "    : `Service fee is ${res.fee}`, function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res.details.usedAmount).to.be.at.most(res.details.maxAmount);",
                  "    } else {",
                  "        pm.expect(res.fee).to.be.a(\"number\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "bearer {{cusomer02_token}}",
                "type": "text"
              },
              {
                "key": "X-AUTH-SECRET-KEY",
                "value": "{{partnerKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account\": \"01953925303\",\n  \"to_account\": \"01953925304\",\n  \"amount\": 2000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}transaction/sendmoney",
              "host": [
                "{{baseUrl}}transaction"
              ],
              "path": [
                "sendmoney"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Customer Cashout Via Agent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const limitHit = res.message.includes(\"limit exceeded\");",
                  "",
                  "pm.test(limitHit ? \"Daily Amount Exceed\" : \"Withdraw successful\", function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res.details.remainingAmount).to.be.a(\"number\");",
                  "    } else {",
                  "        pm.expect(res.message).to.include(\"Withdraw successful\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(`Service fee is ${limitHit ? \"N/A (limit exceeded)\" : res.fee}`, function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res).to.not.have.property(\"fee\");",
                  "    } else {",
                  "        pm.expect(res.fee).to.be.a(\"number\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(`Current Balance is ${limitHit ? \"N/A (limit exceeded)\" : res.currentBalance}`, function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res).to.not.have.property(\"currentBalance\");",
                  "    } else {",
                  "        pm.expect(res.currentBalance).to.be.a(\"number\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
