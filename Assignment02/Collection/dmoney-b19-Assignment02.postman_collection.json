          "name": "Customer Deposit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const limitHit = /limit exceeded/i.test(res.message || \"\");",
                  "",
                  "// pull the number out of \"...maximum of 515.00 tk...\" for the labels",
                  "const maxAllowed = limitHit ? (res.message.match(/[\\d,]+\\.?\\d*/) || [\"N/A\"])[0] : null;",
                  "",
                  "pm.test(limitHit ? \"Deposit Limit Exceed\" : \"Deposit successful\", function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res.message).to.be.a(\"string\");",
                  "    } else {",
                  "        pm.expect(res.message).to.include(\"Deposit successful\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(limitHit",
                  "    ? `Deposit Limit Exceed - max allowed ${maxAllowed} Tk`",
                  "    : `Commission is ${res.commission}`, function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res.message).to.match(/limit exceeded/i);",
                  "    } else {",
                  "        pm.expect(res.commission).to.be.a(\"number\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(limitHit",
                  "    ? \"Deposit Limit Exceed - no transaction created\"",
                  "    : `Current Balance is ${res.currentBalance}`, function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res).to.not.have.property(\"trnxId\");",
                  "    } else {",
                  "        pm.expect(res.currentBalance).to.be.a(\"number\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
