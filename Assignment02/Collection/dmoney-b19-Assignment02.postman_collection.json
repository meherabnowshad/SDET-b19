        {
          "name": "Merchant Pay",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const limitHit = res.message && res.message.includes(\"limit exceeded\");",
                  "",
                  "pm.test(limitHit ? \"Daily Amount Exceed\" : \"Payment successful\", function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res.details).to.be.an(\"object\");",
                  "        pm.expect(res.details.period).to.be.a(\"string\");",
                  "    } else {",
                  "        pm.expect(res.message).to.include(\"Payment successful\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(limitHit",
                  "    ? `Daily Amount Exceed - remaining ${res.details.remainingAmount} Tk`",
                  "    : `Service fee is ${res.fee}`, function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res.details.remainingAmount).to.be.a(\"number\");",
                  "    } else {",
                  "        pm.expect(res.fee).to.be.a(\"number\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(limitHit",
                  "    ? `Daily Amount Exceed - used ${res.details.usedAmount} of ${res.details.maxAmount} Tk`",
                  "    : `Current Balance is ${res.currentBalance}`, function () {",
                  "    if (limitHit) {",
                  "        pm.expect(res.details.usedAmount).to.be.at.most(res.details.maxAmount);",
                  "    } else {",
                  "        pm.expect(res.currentBalance).to.be.a(\"number\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
